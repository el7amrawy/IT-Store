@model ViewModel_EditAdmin
@{
    Layout = "_Admin-Layout";
    ViewBag.Title = "Edit Admin";
}

    <form class="row" asp-action="Edit" enctype="multipart/form-data">
        <input hidden asp-for="Id" />
        <div class="col-md-4">
            <div>
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <div class="form-group my-4">
                    <label asp-for="FirstName" class="control-label"></label>
                    <input asp-for="FirstName" class="form-control" />
                    <span asp-validation-for="FirstName" class="text-danger"></span>
                </div>
                <div class="form-group my-4">
                    <label asp-for="LastName" class="control-label"></label>
                    <input asp-for="LastName" class="form-control" />
                    <span asp-validation-for="LastName" class="text-danger"></span>
                </div>
                <div class="form-group my-4">
                    <label asp-for="UserName" class="control-label"></label>
                    <input asp-for="UserName" class="form-control" />
                    <span asp-validation-for="UserName" class="text-danger"></span>
                </div>
                <div class="form-group my-4">
                    <label asp-for="Email" class="control-label"></label>
                    <input asp-for="Email" class="form-control" />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>
                <div class="form-group my-4">
                    <label class="control-label" asp-for="UserRoles"></label>
                    <table class="table">
                        <tbody>
                        @foreach (var item in Model.UserRoles)
                        {
                            <tr class="mx-2 text-sm">
                                <td>@item</td>
                                <td>
                                    <a asp-controller="Admins" asp-action="DeleteRole" asp-route-role="@item" class="link-underline-danger text-danger">
                                        Delete
                                    </a>
                                </td>
                            </tr>
                        }
                        </tbody>
                       
                    </table>
                </div>
                <div class="form-group my-4">
                    <label class="control-label">Add New Role</label>
                    <select class=" form-select" asp-for="NewRole" asp-items="Model.Roles">
                        <option selected default value="0"></option>
                    </select>
                    <span asp-validation-for="NewRole" class="text-danger"></span>
                </div>
                <div class="form-group my-4">
                    <input type="submit" value="Save" class="btn btn-primary" />
                </div>
            </div>
        </div>
        <div class="col-md-4 flex justify-content-end">
            <img src="/@(Model?.Avatar??"http://ssl.gstatic.com/accounts/ui/avatar_2x.png")" />
            <div class="form-group my-4">
                <label asp-for="Image" class="control-label">Update Profile Photo</label>
                <input type="file" asp-for="Image" class="form-control" />
                <span asp-validation-for="Image" class="text-danger"></span>
            </div>
        </div>
    </form>

<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}