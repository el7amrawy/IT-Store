@model IEnumerable<Order>
@{
	Layout = "_Admin-Layout";
	ViewData["Title"] = "Orders";
}

<div class="row">
	<div class="col-12 col-lg-8 col-xxl-12 d-flex">
		<div class="card flex-fill">
			<div class="card-header">

				<h5 class="card-title mb-0">Orders</h5>
			</div>
			<table class="table table-hover my-0">
				<thead>
					<tr>
						<th class="d-none d-xl-table-cell">@Html.DisplayNameFor(model => model.OrderId)</th>
						<th>Customer Name</th>
						<th class="d-none d-xl-table-cell">@Html.DisplayNameFor(model => model.Total)</th>
						<th class="d-none d-xl-table-cell">@Html.DisplayNameFor(model => model.StatusId)</th>
						<th class="d-none d-xl-table-cell">@Html.DisplayNameFor(model => model.CreatedAt)</th>
						<th class="d-none d-md-table-cell"></th>
					</tr>
				</thead>
				<tbody>
					@foreach (var item in Model)
					{
						<tr>
							<td>@item.OrderId</td>
							<td>@(item.User.FirstName) @(item.User.LastName)</td>
							<td class="d-none d-xl-table-cell">E£<strong>@Html.DisplayFor(modelItem => item.Total)</strong></td>
							<td class="d-none d-xl-table-cell">
								@{
									switch (item.StatusEnum){
										case OrderStatusEnum.Pending:
											<span class=" bg-warning p-2 text-white rounded-2">
												@Html.DisplayFor(modelItem => item.StatusEnum)
											</span>
											break;
										case OrderStatusEnum.Delivered:
											<span class=" bg-light p-2 text-white rounded-2">
												@Html.DisplayFor(modelItem => item.StatusEnum)
											</span>
											break;
										case OrderStatusEnum.Shipped:
											<span class="bg-success p-2 text-white rounded-2">
												@Html.DisplayFor(modelItem => item.StatusEnum)
											</span>
											break;
										case OrderStatusEnum.Processing:
											<span class="bg-info p-2 text-white rounded-2">
												@Html.DisplayFor(modelItem => item.StatusEnum)
											</span>
											break;
										case OrderStatusEnum.Cancelled:
											<span class=" bg-danger p-2 text-white rounded-2">
												@Html.DisplayFor(modelItem => item.StatusEnum)
											</span>
											break;
									}
								}
							</td>
							<td class="d-none d-xl-table-cell">@Html.DisplayFor(modelItem => item.CreatedAt)</td>
							<td class="d-none d-xl-table-cell">
								<a class="btn text-white bg-primary" asp-action="Details" asp-controller="Orders" asp-route-id="@item.OrderId">
									<i class="align-middle" data-feather="info"></i> <span class="align-middle">Details</span>
								</a>
							</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
	</div>
</div>