@model IEnumerable<ProductAttribute>
@{
	Layout = "_Admin-Layout";
	ViewBag.Title = "Product Attributes";
}

<a class=" m-3 btn bg-primary text-white" asp-action="Add" asp-asp-controller="ProductAttributes">Add Product Attribute</a>

<div class="row">
	<div class="col-12 col-lg-8 col-xxl-12 d-flex">
		<div class="card flex-fill">
			<div class="card-header">

				<h5 class="card-title mb-0">Product Attributes</h5>
			</div>
			<table class="table table-hover my-0">
				<thead>
					<tr>
						<th>@Html.DisplayNameFor(model => model.Id)</th>
						<th>@Html.DisplayNameFor(model => model.Name)</th>
						<th class="d-none d-xl-table-cell">@Html.DisplayNameFor(model => model.CreatedAt)</th>
						<th class="d-none d-md-table-cell"></th>
					</tr>
				</thead>
				<tbody>
					@foreach (var item in Model)
					{
						<tr>
							<td>@Html.DisplayFor(modelItem => item.Id)</td>
							<td>@Html.DisplayFor(modelItem => item.Name)</td>
							<td class="d-none d-xl-table-cell">@Html.DisplayFor(modelItem => item.CreatedAt)</td>
							<td class="d-none d-xl-table-cell">
								<a class="btn text-white bg-danger" asp-action="Delete" asp-controller="ProductAttributes" asp-route-id="@item.Id">
									<i class="align-middle" data-feather="delete"></i> <span class="align-middle">Delete</span>
								</a>
							</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
	</div>
</div>